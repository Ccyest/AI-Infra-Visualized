---
import { CHROME, lessonNo } from "../lib/i18n";
import type { Locale } from "../lib/i18n";
import { lessonPath, publishedLessons } from "../lib/lessons";
import { withBase } from "../lib/paths";
import { SITE } from "../site.config";
import Base from "./Base.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const lessons = await publishedLessons(locale);
---

<Base title={SITE.title} locale={locale}>
  <section class="hero reveal">
    <h1>{CHROME.heroTitle[locale]}</h1>
    <p>{CHROME.heroBody[locale]}</p>
    <p>
      {CHROME.heroCompanion[locale]}
      <a href={SITE.tutorialUrl} target="_blank" rel="noopener">Awesome-ML-SYS-Tutorial</a>{CHROME.heroCompanionTail[locale]}
      <a href={SITE.inspirationUrl} target="_blank" rel="noopener">bbycroft.net/llm</a>{CHROME.period[locale]}
    </p>
    <p class="hero-credit">
      {CHROME.heroCredit[locale]}
      <a href={SITE.author.url} target="_blank" rel="noopener">{SITE.author.name}</a>{CHROME.heroCreditTail[locale]}
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={SITE.sglangUrl} target="_blank" rel="noopener">
        {CHROME.buildWithSglang[locale]}
      </a>
      <a class="btn btn-ghost" href={SITE.repoUrl} target="_blank" rel="noopener">
        GitHub
      </a>
    </div>
  </section>

  <ol class="lesson-list">
    {
      lessons.map(({ entry, slug }) => (
        <li class="reveal">
          <a class="lesson-card" href={withBase(lessonPath(locale, slug))}>
            <span class="lesson-order">{lessonNo(locale, entry.data.order)}</span>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.description}</p>
            {entry.data.concepts.length > 0 && (
              <span class="concept-chips">
                {entry.data.concepts.map((c) => (
                  <span class="concept-chip">{c}</span>
                ))}
              </span>
            )}
          </a>
        </li>
      ))
    }
  </ol>
</Base>
